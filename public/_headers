# Cloudflare Pages custom headers
# https://developers.cloudflare.com/pages/configuration/headers/

# Security hardening applied to every response
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Always revalidate the app HTML so a new deploy is picked up immediately
# (prevents stale copies lingering in the edge/browser cache)
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
